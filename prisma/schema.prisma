generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  STOCK_MANAGER
  ACCOUNTANT
  VIEWER
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  PASSWORD_CHANGE
  SUBSCRIPTION_CHANGE
}

enum SubscriptionPlan {
  FREE
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  MANUAL
  GENERIC
}

enum DocumentType {
  QUOTE
  INVOICE
  DELIVERY_NOTE
  RECEIPT
  CREDIT_NOTE
}

enum DocumentStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  RETURNED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  Membership[]
  sessions     Session[]
  auditLogs    AuditLog[] @relation("ActorAudit")
  notifications Notification[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  phone     String?
  email     String?
  address   String?
  currency  String   @default("XAF")
  timezone  String   @default("Africa/Libreville")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         Membership[]
  auditLogs           AuditLog[]
  products            Product[]
  customers           Customer[]
  suppliers           Supplier[]
  sales               Sale[]
  purchases           Purchase[]
  documents           Document[]
  returns             Return[]
  expenses            Expense[]
  employees           Employee[]
  payrolls            Payroll[]
  treasuryTransactions TreasuryTransaction[]
  stockMovements      StockMovement[]
  subscription        Subscription?
  notifications       Notification[]
  paymentOrders       PaymentOrder[]
}

model Subscription {
  id               String             @id @default(cuid())
  companyId        String             @unique
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime
  currentPeriodEnd DateTime?
  maxUsers         Int                @default(2)
  maxProducts      Int                @default(100)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([plan, status])
}

model PaymentOrder {
  id          String             @id @default(cuid())
  companyId   String
  plan        SubscriptionPlan
  amount      Int
  currency    String             @default("XAF")
  provider    PaymentProvider    @default(GENERIC)
  status      PaymentOrderStatus @default(PENDING)
  externalId  String?            @unique
  checkoutUrl String?
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  paidAt      DateTime?
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  companyId String?
  title     String
  message   String
  type      String    @default("INFO")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model Session {
  id         String        @id @default(cuid())
  tokenHash  String        @unique
  userId     String
  status     SessionStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AuditLog {
  id        String       @id @default(cuid())
  action    AuditAction
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime     @default(now())
  actorId   String?
  companyId String?
  actor     User?        @relation("ActorAudit", fields: [actorId], references: [id], onDelete: SetNull)
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model Product {
  id            String   @id @default(cuid())
  companyId     String
  sku           String
  name          String
  purchasePrice Int      @default(0)
  salePrice     Int      @default(0)
  stock         Int      @default(0)
  minStock      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  documentItems  DocumentItem[]

  @@unique([companyId, sku])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  balance   Int      @default(0)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sales     Sale[]
  documents Document[]
  returns   Return[]
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  balance   Int      @default(0)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  purchases Purchase[]
}

model Sale {
  id         String   @id @default(cuid())
  companyId  String
  total      Int
  payment    String
  createdAt  DateTime @default(now())
  customerId String?
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items     SaleItem[]
  documents Document[]
  returns   Return[]

  @@index([companyId, createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Int
  total     Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
}

model Purchase {
  id         String    @id @default(cuid())
  companyId  String
  supplierId String?
  total      Int
  payment    String
  createdAt  DateTime  @default(now())
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  items PurchaseItem[]

  @@index([companyId, createdAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitPrice  Int
  total      Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
}

model StockMovement {
  id        String   @id @default(cuid())
  companyId String
  productId String
  type      String
  quantity  Int
  note      String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model Expense {
  id        String   @id @default(cuid())
  companyId String
  label     String
  amount    Int
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Employee {
  id        String   @id @default(cuid())
  companyId String
  firstName String
  lastName  String
  phone     String?
  position  String?
  salary    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  payrolls Payroll[]

  @@index([companyId])
}

model Payroll {
  id         String    @id @default(cuid())
  companyId  String
  employeeId String
  period     String
  gross      Int
  deductions Int       @default(0)
  bonus      Int       @default(0)
  net        Int
  status     String    @default("UNPAID")
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([companyId, period])
}

model TreasuryTransaction {
  id        String   @id @default(cuid())
  companyId String
  type      String
  account   String
  amount    Int
  label     String
  reference String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model Document {
  id         String         @id @default(cuid())
  companyId  String
  number     String
  type       DocumentType
  status     DocumentStatus @default(DRAFT)
  customerId String?
  saleId     String?
  subtotal   Int            @default(0)
  discount   Int            @default(0)
  tax        Int            @default(0)
  total      Int            @default(0)
  paid       Int            @default(0)
  notes      String?
  issuedAt   DateTime?
  dueAt      DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale     Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items    DocumentItem[]

  @@unique([companyId, number])
  @@index([companyId, type, createdAt])
}

model DocumentItem {
  id          String   @id @default(cuid())
  documentId  String
  productId   String?
  description String
  quantity    Int      @default(1)
  unitPrice   Int      @default(0)
  total       Int      @default(0)
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([documentId])
}

model Return {
  id           String    @id @default(cuid())
  companyId    String
  saleId       String?
  customerId   String?
  amount       Int       @default(0)
  reason       String
  refundMethod String?
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale         Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}