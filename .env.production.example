# PostgreSQL managé (Neon, Supabase, Railway, Render, etc.)
# Utiliser une URL SSL en production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret aléatoire long (32+ caractères). Ne jamais utiliser admin123 ici.
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# URL publique exacte de BizManager.
APP_URL="https://votre-domaine.com"

# Optionnel : version affichée par le diagnostic.
APP_VERSION="5.1.0"
